{
  "name": "R SFTP Dev Env",
  "image": "ghcr.io/rocker-org/devcontainer/tidyverse:4.4",
  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r",
        "continue.continue"
      ]
    }
  },
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/r-apt:latest": {
      "installDevTools": true,
      "installREnv": true,
      "installRMarkdown": true,
      "vscodeRSupport": "lsp"
    },
    // This feature mounts the persistent volume for R packages
    "ghcr.io/rocker-org/devcontainer-features/renv-cache:latest": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },
  // This starts your test SFTP server automatically on boot
  "postCreateCommand": "chmod +x .devcontainer/*.sh && bash .devcontainer/run_sftp.sh",
  "postStartCommand": "bash .devcontainer/start_sftp.sh"
}